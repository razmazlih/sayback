{
  "name": "sayback",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:identity": "node scripts/run-identity-tests.mjs",
    "test:conversations": "node scripts/run-conversation-profile-tests.mjs",
    "test:my-voice": "node scripts/run-my-voice-tests.mjs",
    "test:deeplinks": "node scripts/run-home-deeplink-tests.mjs",
    "test:product-contract": "node --test tests/product-contract.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:identity && npm run test:conversations && npm run test:my-voice && npm run test:deeplinks && npm run test:product-contract && npm run test:generation && npm run build",
    "test:generation": "node --test tests/generation-lifecycle.test.mjs tests/generation-access.test.mjs tests/generator-first-flow.test.mjs tests/generation-context.test.mjs tests/reply-history.test.mjs tests/ai-reply-context.test.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.0.1",
    "@vercel/analytics": "^1.5.0",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^21.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
