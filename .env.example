# SayBack environment template
# Copy to local env file:
# cp .env.example .env.local
#
# Notes:
# - `NEXT_PUBLIC_*` values are exposed to the browser.
# - Non-`NEXT_PUBLIC_*` values stay server-side.

# =========================================
# AI Mode
# =========================================
# Default: local free mode (no OpenAI calls).
LOCAL_FREE_AI=true

# Paid AI mode:
# 1) set LOCAL_FREE_AI=false
# 2) set OPENAI_API_KEY
# OPENAI_API_KEY=sk-your-openai-api-key

# Optional model override (default: gpt-5.3-chat-latest)
# OPENAI_MODEL=gpt-5.3-chat-latest

# =========================================
# Billing bypass (temporary)
# =========================================
# Disables paywall/checkout and allows unlimited usage.
# Keep BOTH flags with the same value.
# BILLING_BYPASS=true
# NEXT_PUBLIC_BILLING_BYPASS=true

# =========================================
# Stripe (required for checkout/webhooks)
# =========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# =========================================
# Firebase Admin (server-side auth + Firestore)
# =========================================
# Option A (recommended): set these 3 variables
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: single JSON secret instead of the 3 vars above
# FIREBASE_SERVICE_ACCOUNT_JSON={"projectId":"...","clientEmail":"...","privateKey":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# =========================================
# Firebase Client (browser SDK)
# =========================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_public_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Optional (not required by current client init):
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# =========================================
# Canonical URLs
# =========================================
# Public canonical URL for sharing/metadata (recommended)
# Example: https://example.com
NEXT_PUBLIC_SITE_URL=

# Server canonical URL for checkout return URLs.
# If set, this takes precedence over request host headers.
# Example: https://example.com
SITE_URL=

# On Vercel, VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL are injected automatically.

# =========================================
# Analytics (optional, client-side)
# =========================================
# GA4 format: G-XXXXXXXXXX
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Backward-compatible GA alias
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity project id
# NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# Local analytics debug mode (no external dependency required)
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# =========================================
# Debug/admin/ops flags (optional)
# =========================================
# Local dev only: show "reset usage quota" button in the UI
# NEXT_PUBLIC_ENABLE_QUOTA_RESET=true

# Local admin page gate (disabled by default, only for local development)
# LOCAL_ADMIN_ENABLED=true

# Persist generation usage logs to Firestore collection `generation_usage_logs`
# Recommended: enable in production only
# PERSIST_USAGE_LOGS=true

# Allow persisted usage logging in local development
# ALLOW_DEV_PERSIST_USAGE_LOGS=true
